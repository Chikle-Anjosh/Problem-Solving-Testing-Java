import java.util.Arrays;

public class ShuffleArray {
    public static void main(String[] args) {
        int arr[] = {2,5,1,3,4,7};
        int n = arr.length/2;
        int res[] = new int[2*n];
        int l=0;
        int r=n;
        int index=0;
        while(l<n){
            res[index++]=arr[l++];
            res[index++]=arr[r++];
        }
        System.out.println(Arrays.toString(res));
    }
}
